# Copy to .env and edit. Never commit .env.

# --- Budget guard -----------------------------------------------------------
STUDIO_MONTHLY_BUDGET_USD=250
# Paid providers stay OFF unless this is 1. Even then, each paid call needs
# explicit consent (--i-consent-to-spend) and must fit under the monthly cap.
# Note: a Claude Pro subscription is NOT an Anthropic API entitlement.
STUDIO_ENABLE_PAID_PROVIDERS=0

# --- Voice ------------------------------------------------------------------
# mock (silent placeholder) | macos_say (local preview, non-commercial licence) | elevenlabs
STUDIO_VOICE_PROVIDER=mock
# ElevenLabs (optional, paid). Nothing is sent unless STUDIO_ENABLE_PAID_PROVIDERS=1,
# the key is set AND you pass --i-consent-to-spend; the request size is capped at the
# preflighted character count. Commercial use needs a PAID plan at generation time.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=           # a stock/library voice you are licensed to use (no clones)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_PLAN=               # free | starter | creator | pro | scale | business
# ELEVENLABS_USD_PER_1K_CHARS=0.08   # API pay-as-you-go list price (checked 2026-11-18)

# --- YouTube (feature flag; uploads are always private) ----------------------
STUDIO_ENABLE_YOUTUBE=0
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
# YOUTUBE_CLIENT_SECRETS_FILE=~/secrets/youtube_client_secret.json

# --- Rendering --------------------------------------------------------------
# Optional explicit FFmpeg path (default: PATH, then the bundled imageio-ffmpeg binary)
# STUDIO_FFMPEG=/opt/homebrew/bin/ffmpeg
# Optional font for all rendered text; prefer an OFL font such as Inter
# STUDIO_FONT=/Users/you/Library/Fonts/Inter-Regular.ttf
# STUDIO_PROJECTS_DIR=./projects
